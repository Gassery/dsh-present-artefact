{
  "name": "dsh-present-artefact",
  "version": "2.1.2",
  "description": "A present_artefact tool that shows one produced artefact in a review card and waits for the user's approval, without requiring write access.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "review"
  ],
  "license": "MIT",
  "author": "Gassery",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gassery/dsh-tool-present-plan.git"
  },
  "homepage": "https://github.com/Gassery/dsh-tool-present-plan#readme",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
